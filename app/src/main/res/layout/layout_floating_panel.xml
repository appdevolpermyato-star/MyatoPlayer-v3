<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_panel_root"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_panel"
    android:padding="16dp"
    android:elevation="16dp">

    <!-- Header: MP Logo + App Title + Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/panel_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/myato_logo"
            android:contentDescription="MP Logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/panel_logo"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MYATO FLOATING"
                android:textColor="#F3F0F5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STREET CULTURE"
                android:textColor="#A855F7"
                android:textSize="9sp"
                android:letterSpacing="0.15" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_panel_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Minimizar Painel"
            android:tint="#918A99" />
    </RelativeLayout>

    <!-- Track Info Row: Album Art + Song Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/iv_panel_cover"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_shortcut_pill"
            android:src="@drawable/ic_mp_street_logo"
            android:contentDescription="Capa da Música" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_panel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nenhuma música tocando"
                android:textColor="#F3F0F5"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_panel_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Myato Player"
                android:textColor="#918A99"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Progress Bar & Timestamps -->
    <SeekBar
        android:id="@+id/sb_panel_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:progressTint="#A855F7"
        android:thumbTint="#F3F0F5"
        android:progressBackgroundTint="#33A855F7" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_panel_current_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="#918A99"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_panel_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#918A99"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Playback Controls: Shuffle, Prev, Play/Pause, Next, Repeat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <!-- Shuffle -->
        <ImageButton
            android:id="@+id/btn_panel_shuffle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            android:tint="#918A99"
            android:contentDescription="Aleatório" />

        <Space
            android:layout_width="12dp"
            android:layout_height="wrap_content" />

        <!-- Previous -->
        <ImageButton
            android:id="@+id/btn_panel_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#F3F0F5"
            android:contentDescription="Anterior" />

        <Space
            android:layout_width="16dp"
            android:layout_height="wrap_content" />

        <!-- Play / Pause Main Highlight Button -->
        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp">

            <ImageButton
                android:id="@+id/btn_panel_play_pause"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_floating_play_btn"
                android:src="@android:drawable/ic_media_play"
                android:tint="#09090D"
                android:scaleType="centerInside"
                android:contentDescription="Tocar/Pausar" />
        </FrameLayout>

        <Space
            android:layout_width="16dp"
            android:layout_height="wrap_content" />

        <!-- Next -->
        <ImageButton
            android:id="@+id/btn_panel_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:tint="#F3F0F5"
            android:contentDescription="Próxima" />

        <Space
            android:layout_width="12dp"
            android:layout_height="wrap_content" />

        <!-- Repeat -->
        <ImageButton
            android:id="@+id/btn_panel_repeat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#918A99"
            android:contentDescription="Repetir" />
    </LinearLayout>

    <!-- 4 Quick Access Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Biblioteca -->
        <LinearLayout
            android:id="@+id/card_panel_library"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_shortcut_pill"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="#A855F7"
                android:contentDescription="Biblioteca" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Biblioteca"
                android:textColor="#F3F0F5"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Favoritos -->
        <LinearLayout
            android:id="@+id/card_panel_favorites"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_shortcut_pill"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/btn_star_big_on"
                android:tint="#A855F7"
                android:contentDescription="Favoritos" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Favoritos"
                android:textColor="#F3F0F5"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Playlists -->
        <LinearLayout
            android:id="@+id/card_panel_playlists"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_shortcut_pill"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="#A855F7"
                android:contentDescription="Playlists" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Playlists"
                android:textColor="#F3F0F5"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Abrir App -->
        <LinearLayout
            android:id="@+id/card_panel_open_app"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_shortcut_pill"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_directions"
                android:tint="#F3F0F5"
                android:contentDescription="Abrir App" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Abrir App"
                android:textColor="#A855F7"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
